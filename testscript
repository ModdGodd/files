local function throttledUpdate(callback)
    if debounceTime > tick() then return end
    debounceTime = tick() + 0.2  -- Fixed throttle
    task.wait(math.random(50, 100) / 100)
    callback()
    for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then applyHitbox(p) end end
end

