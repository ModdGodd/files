local debounceTime = 0  -- For throttling
local resetInterval = 30  -- Seconds between subtle resets to evade detection

-- Obfuscated defaults (slight randomization for natural variance)
local defaultSizes = {  -- Per-part defaults
    HumanoidRootPart = Vector3.new(2, 2, 1),
    Head = Vector3.new(1, 1, 1),
    Torso = Vector3.new(2, 1, 1),  -- R6 fallback
