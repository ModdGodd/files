    LeftLowerArm = Vector3.new(1, 1.5, 1), RightLowerArm = Vector3.new(1, 1.5, 1),
    LeftUpperLeg = Vector3.new(1, 2, 1), RightUpperLeg = Vector3.new(1, 2, 1),
    LeftLowerLeg = Vector3.new(1, 2, 1), RightLowerLeg = Vector3.new(1, 2, 1)
}
local targetParts = {"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", 
                     "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand",
                     "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot"}

